# --- DEEPPREDICTBET BACKEND CONFIGURATION ---
PORT=5000
NODE_ENV=development
APP_NAME=DeepPredictBet
APP_DOMAIN=http://localhost:5173

# --- DATABASE CONFIGURATION ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deeppredictbet_db?schema=public"
REDIS_URL="redis://localhost:6379"

# --- SECURITY & JWT ---
JWT_SECRET="super_secret_deeppredictbet_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# --- AFFILIATE DEFAULT CODE ---
DEFAULT_AFFILIATE_TAG="deeppredictbet_official"
