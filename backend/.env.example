# --- BETMINES BACKEND CONFIGURATION ---
PORT=5000
NODE_ENV=development
APP_NAME=BetMines
APP_DOMAIN=http://localhost:5173

# --- DATABASE CONFIGURATION ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betmines_db?schema=public"
REDIS_URL="redis://localhost:6379"

# --- SECURITY & JWT ---
JWT_SECRET="super_secret_betmines_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# --- AFFILIATE DEFAULT CODE ---
DEFAULT_AFFILIATE_TAG="betmines_official"
