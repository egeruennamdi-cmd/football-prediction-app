// DeepPredictBet Prisma PostgreSQL Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PRO
  VIP
  ADMIN
}

enum MarketCategory {
  MATCH_RESULT_1X2
  OVER_UNDER_GOALS
  BOTH_TEAMS_SCORE
  DOUBLE_CHANCE
  DRAW_NO_BET
  CORNER_MATCH_BET
  CARDS_MATCH_BET
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  fullName      String?
  role          Role            @default(USER)
  coinsBalance  Int             @default(50)
  referralCode  String          @unique @default(uuid())
  conversions   ConversionLog[]
  auditedSlips  AuditedSlip[]
  savedTickets  SavedTicket[]
  watchlists    UserWatchlist[]
  subscriptions Subscription[]
  coinLedger    CoinTransaction[]
  lastActiveAt  DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum TicketStatus {
  PENDING
  WON
  LOST
  VOID
  CANCELLED
}

model SavedTicket {
  id              String       @id @default(uuid())
  bookingCode     String
  bookmaker       String
  totalOdds       Float
  selectionsCount Int          @default(1)
  selections      Json
  status          TicketStatus @default(PENDING)
  source          String       @default("GENERATOR")
  stake           Float?
  potentialWin    Float?
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  createdAt       DateTime     @default(now())
}

model UserWatchlist {
  id          String   @id @default(uuid())
  matchId     String
  fixtureName String
  league      String
  kickoffTime String
  primaryTip  String?
  odds        Float?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, matchId])
}

model Subscription {
  id               String    @id @default(uuid())
  tier             String
  status           String    @default("ACTIVE")
  amount           Float
  currency         String    @default("NGN")
  paymentReference String?
  paymentGateway   String?
  startDate        DateTime  @default(now())
  expiresAt        DateTime
  cancelledAt      DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  createdAt        DateTime  @default(now())
}

model CoinTransaction {
  id           String   @id @default(uuid())
  amount       Int
  balanceAfter Int
  action       String
  reference    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model PlatformDailyTelemetry {
  date               String   @id
  predictionViews    Int      @default(0)
  doctorAudits       Int      @default(0)
  converterRequests  Int      @default(0)
  converterSuccesses Int      @default(0)
  generatorRuns      Int      @default(0)
  scannerViews       Int      @default(0)
  newRegistrations   Int      @default(0)
  newSubscriptions   Int      @default(0)
  revenueNgn         Float    @default(0.0)
  updatedAt          DateTime @updatedAt
}

model ConversionLog {
  id               String   @id @default(uuid())
  sourceBookie     String
  targetBookie     String
  sourceCode       String
  targetCode       String
  totalOdds        Float
  affiliateTagUsed String
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
}

model AuditedSlip {
  id                   String   @id @default(uuid())
  sourceCode           String
  sourceBookie         String
  healthScore          Float
  rawProbability       Float
  optimizedProbability Float
  trapMatchesDetected  Int      @default(0)
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  createdAt            DateTime @default(now())
}

model ArbitrageOpportunity {
  id             String   @id @default(uuid())
  matchName      String
  league         String
  market         String
  netRoiPercent  Float
  leg1Bookie     String
  leg1Selection  String
  leg1Odds       Float
  leg2Bookie     String
  leg2Selection  String
  leg2Odds       Float
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}
